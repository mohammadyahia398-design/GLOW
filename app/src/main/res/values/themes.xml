<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- الوضع الفاتح. الواجهة نفسها مبنية بـ Compose. -->
    <style name="Theme.Glow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/glow_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ثيم البدء: شاشة النظام (SplashScreen API) ثم ينتقل إلى Theme.Glow. -->
    <style name="Theme.Glow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/glow_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_tile</item>
        <item name="postSplashScreenTheme">@style/Theme.Glow</item>
    </style>
</resources>
